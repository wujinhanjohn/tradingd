# Copy to `.env` and fill in, then export these into your shell before running the
# bot (`set -a; . ./.env; set +a`). The bot reads the process environment only - it
# does not parse .env itself, so nothing here is loaded implicitly.

# --- required ---
# Binance spot TESTNET API credentials. The bot refuses to start without both.
# Generate a pair at https://testnet.binance.vision (sign in with GitHub ->
# "Generate HMAC_SHA256 Key"). Never commit real values.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- optional: config overrides ---
# Every field in config.toml can be overridden with an APP_-prefixed variable.
# Nested keys use a double underscore.
#   APP_ENVIRONMENT=testnet
#   APP_BINANCE__SPOT_REST_URL=https://testnet.binance.vision
#   APP_BINANCE__RECV_WINDOW_MS=5000
#   APP_LOGGING__LEVEL=debug
#   APP_LOGGING__JSON=true
# APP_* is reserved for config keys. An APP_* variable that does not name a real
# config field is rejected at startup rather than silently ignored.

# --- optional: logging ---
# Overrides logging.level from config.toml when set.
#   RUST_LOG=debug,domain=trace

# --- production kill-switch ---
# Testnet needs nothing. Running with environment = "production" additionally
# requires this variable, set to this exact value, or the bot refuses to start.
# Deliberately NOT APP_-prefixed: it is not a config field, and must never be
# settable from a checked-in config.toml.
#   ALLOW_PRODUCTION=I_UNDERSTAND_THE_RISK
